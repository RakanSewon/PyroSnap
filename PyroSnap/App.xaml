<Application x:Class="PyroSnap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <!--
        Sistem desain PyroSnap (docs/ui/design-system.md).
        Indeks 0 = kamus WARNA tema aktif (Themes/Terang.xaml atau Themes/Gelap.xaml),
        diganti saat runtime oleh Views/Tema.cs (DS-06). Indeks 1 = gaya & template bersama.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Terang.xaml" />
                <ResourceDictionary Source="Themes/Gaya.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
