<Window x:Class="PyroSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PyroSnap"
        mc:Ignorable="d"
        Title="PyroSnap" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F3F0">
    <!--
        MainWindow berperan sebagai host navigasi (shell).
        Setiap "form"/tampilan dimuat ke dalam Frame di bawah ini.
        Perpindahan antar tampilan dilakukan lewat MainWindow.Navigate(...).
    -->
    <Frame x:Name="MainFrame"
           NavigationUIVisibility="Hidden"
           Focusable="False" />
</Window>
