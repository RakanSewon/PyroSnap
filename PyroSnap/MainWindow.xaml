<Window x:Class="PyroSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PyroSnap"
        mc:Ignorable="d"
        Title="PyroSnap — Pemantauan Titik Panas" Height="700" Width="1080"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}">
    <!--
        MainWindow berperan sebagai host navigasi (shell).
        Setiap "form"/tampilan dimuat ke dalam Frame di bawah ini.
        Perpindahan antar tampilan dilakukan lewat Views/Navigasi.cs.
        FE-07: ukuran minimum mencegah panel terpotong.
    -->
    <Frame x:Name="MainFrame"
           NavigationUIVisibility="Hidden"
           Focusable="False" />
</Window>
