<Page x:Class="PyroSnap.Views.ExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="960"
      Title="Export Laporan Hotspot"
      Background="{StaticResource PageBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="📄 Export Laporan Hotspot" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Pilih format berkas laporan dan tinjau pratinjau sebelum mengekspor ke penyimpanan lokal"
                               Foreground="White" Opacity="0.9" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="← Kembali ke Dashboard" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="36" Padding="14,6" Click="BtnBack_Click" />
            </Grid>
        </Border>

        <!-- Konten Utama -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Pengaturan & Kartu Ringkasan -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="10"
                    Padding="16" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.10" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Kartu Informasi Hotspot -->
                        <Border Background="#FFF1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="RINGKASAN DATA" FontSize="11" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,6" />
                                <TextBlock x:Name="LblInfo" Text="Jumlah hotspot: -" FontSize="14" FontWeight="Bold" Foreground="#FF0F172A" />
                                <TextBlock x:Name="LblDetailRingkas" Text="Sumber: Satelit NASA FIRMS (VIIRS/MODIS)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Pilihan Format Dokumen -->
                        <TextBlock Text="PILIH FORMAT EKSPOR" FontSize="12" FontWeight="Bold" Foreground="#FF334155" Margin="0,0,0,8" />
                        
                        <!-- Pilihan TXT -->
                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <RadioButton x:Name="RbTxt" GroupName="FormatEkspor" IsChecked="True" Checked="Format_Changed">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Teks Naratif (.txt)" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Format teks ringkasan untuk laporan bacaan langsung" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Pilihan CSV -->
                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <RadioButton x:Name="RbCsv" GroupName="FormatEkspor" Checked="Format_Changed">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Tabel CSV (.csv)" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Format baris-kolom untuk analisis di Microsoft Excel" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Pilihan JSON -->
                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                            <RadioButton x:Name="RbJson" GroupName="FormatEkspor" Checked="Format_Changed">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Terstruktur JSON (.json)" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="Format standar API untuk pertukaran data sistem" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <!-- Tombol Aksi -->
                        <Button Content="💾 Export ke File" Style="{StaticResource PrimaryButton}"
                                Height="42" Margin="0,0,0,8" Click="BtnExport_Click" />
                        <Button Content="Salin Isi ke Clipboard" Style="{StaticResource SecondaryButton}"
                                Height="36" Click="BtnCopy_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel Kanan: Kotak Preview Modern Bergaya Code Viewer -->
            <Border Grid.Column="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.10" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Preview Bar -->
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Pratinjau Dokumen" FontWeight="Bold" FontSize="15" Foreground="#FF1E293B" VerticalAlignment="Center" />
                            <Border x:Name="BadgeFormat" Background="#FF0F172A" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblBadgeFormat" Text="TXT" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LblStatusPreview" Text="Siap diekspor" FontSize="12" Foreground="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Code / Text Viewer Box -->
                    <Border Grid.Row="1" Background="#FF1E293B" CornerRadius="8" Padding="10">
                        <TextBox x:Name="TxtPreview" IsReadOnly="True"
                                 Background="Transparent" Foreground="#FFF1F5F9" CaretBrush="#FFF1F5F9"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" TextWrapping="NoWrap" />
                    </Border>

                    <!-- Footer Bar -->
                    <Grid Grid.Row="2" Margin="4,8,4,0">
                        <TextBlock x:Name="LblUkuranPreview" Text="Total karakter: 0" FontSize="11" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="Pratinjau dihasilkan otomatis melalui arsitektur ReportExporter (OOP)"
                                   FontSize="11" Foreground="{StaticResource MutedText}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
