<Page x:Class="PyroSnap.Views.ExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="1000"
      Title="Ekspor Laporan"
      Background="{DynamicResource PageBg}"
      FontSize="13" Foreground="{DynamicResource TextPrimary}">

    <!-- Judul halaman ada di bilah atas shell (MainWindow). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Opsi -->
        <StackPanel Grid.Column="0">
            <!-- KPI jumlah data -->
            <Border Style="{StaticResource Kartu}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Titik panas dalam laporan" Style="{StaticResource Keterangan}" />
                    <TextBlock x:Name="LblInfo" Text="-" Style="{StaticResource AngkaKpi}" Margin="0,4,0,4" />
                    <TextBlock Text="Titik yang sedang tampil di Dashboard (setelah filter)."
                               Style="{StaticResource Keterangan}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Format file" Style="{StaticResource JudulKartu}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource WadahSegmen}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbTxt" Style="{StaticResource Segmen}" GroupName="Format" Content="TXT (teks)"
                                         IsChecked="True" Checked="Format_Changed" />
                            <RadioButton x:Name="RbCsv" Style="{StaticResource Segmen}" GroupName="Format" Content="CSV (Excel)"
                                         Checked="Format_Changed" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnExport" Style="{StaticResource PrimaryButton}"
                            Margin="0,24,0,0" Height="44" IsDefault="True" Click="BtnExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TeksIkon}" FontSize="14" Text="&#xE896;" Margin="0,0,8,0" />
                            <TextBlock Text="Ekspor ke File" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Margin="0,8,0,0" Height="40" Click="BtnBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TeksIkon}" FontSize="14" Text="&#xE72B;" Margin="0,0,8,0" />
                            <TextBlock Text="Kembali ke Dashboard" />
                        </StackPanel>
                    </Button>

                    <!-- Bilah pesan (FE-05) -->
                    <Border x:Name="BarPesan" Style="{StaticResource BilahPesan}" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource IkonPesan}" />
                            <TextBlock x:Name="LblPesan" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Pratinjau -->
        <Border Grid.Column="2" Style="{StaticResource Kartu}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pratinjau laporan" Style="{StaticResource JudulKartu}" />
                <TextBlock x:Name="LblPratinjauInfo" DockPanel.Dock="Top" Style="{StaticResource Keterangan}" Margin="0,2,0,12" />
                <TextBox x:Name="TxtPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" AutomationProperties.Name="Pratinjau laporan" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
