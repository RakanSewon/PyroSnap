<Page x:Class="PyroSnap.Views.ExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1080"
      Title="Ekspor Laporan"
      Background="{StaticResource PageBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <TextBlock Text="Ekspor Laporan Titik Panas" FontSize="20" FontWeight="Bold" Foreground="White" />
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Opsi -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="10"
                    Padding="18" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock x:Name="LblInfo" Text="Jumlah titik panas: -" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="Laporan berisi titik panas yang sedang tampil di Dashboard (setelah filter)."
                               Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="Format:" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <RadioButton x:Name="RbTxt" Content="TXT (teks)" IsChecked="True" Margin="0,0,0,6"
                                 Checked="Format_Changed" />
                    <RadioButton x:Name="RbCsv" Content="CSV (Excel)" Margin="0,0,0,6"
                                 Checked="Format_Changed" />

                    <Button x:Name="BtnExport" Content="Ekspor ke File" Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0" Height="40" IsDefault="True" Click="BtnExport_Click" />
                    <Button Content="Kembali" Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Margin="0,10,0,0" Height="36" Click="BtnBack_Click" />

                    <!-- Bilah pesan (FE-05) -->
                    <Border x:Name="BarPesan" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="LblPesan" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Pratinjau -->
            <Border Grid.Column="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pratinjau Laporan" FontWeight="Bold"
                               Margin="12,10,0,2" />
                    <TextBlock x:Name="LblPratinjauInfo" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}"
                               FontSize="12" Margin="12,0,0,6" />
                    <TextBox x:Name="TxtPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Margin="8,0,8,8" AutomationProperties.Name="Pratinjau laporan" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
