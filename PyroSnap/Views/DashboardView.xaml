<Page x:Class="PyroSnap.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="960"
      Title="Dashboard"
      Background="{StaticResource PageBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🔥 PyroSnap" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Peta Titik Api / Hotspot (NASA FIRMS)"
                               Foreground="White" Opacity="0.9" FontSize="12" />
                </StackPanel>
                <Button Content="Logout" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnLogout_Click" />
            </Grid>
        </Border>

        <!-- Isi -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel kiri: Filter + aksi -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="10"
                    Padding="18" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.12" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Filter Hotspot" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="Confidence minimum (%)" Margin="0,0,0,4" />
                    <Slider x:Name="SldConfidence" Minimum="0" Maximum="100" Value="0"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="SldConfidence_ValueChanged" />
                    <TextBlock x:Name="LblConfidence" Text="0 %" Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Right" />

                    <TextBlock Text="FRP minimum (MW)" Margin="0,12,0,4" />
                    <Slider x:Name="SldFrp" Minimum="0" Maximum="100" Value="0"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="SldFrp_ValueChanged" />
                    <TextBlock x:Name="LblFrp" Text="0 MW" Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Right" />

                    <Button Content="Terapkan Filter" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" Height="38" Click="BtnApplyFilter_Click" />
                    <Button Content="Reset" Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0" Height="34" Click="BtnReset_Click" />

                    <Separator Margin="0,18" />

                    <Button Content="Lihat Detail" Style="{StaticResource SecondaryButton}"
                            Height="38" Margin="0,0,0,8" Click="BtnDetail_Click" />
                    <Button Content="Export Laporan" Style="{StaticResource SecondaryButton}"
                            Height="38" Click="BtnExport_Click" />
                    <Button Content="Muat Ulang Data" Style="{StaticResource SecondaryButton}"
                            Height="34" Margin="0,8,0,0" Click="BtnReload_Click" />
                </StackPanel>
            </Border>

            <!-- Panel kanan: "peta" + daftar -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!-- Peta representasi -->
                <Border Grid.Row="0" Background="#FFE8F0E8" CornerRadius="10"
                        Margin="0,0,0,12" ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="MapCanvas" SizeChanged="MapCanvas_SizeChanged" />
                        <TextBlock Text="Peta Hotspot (representasi) — tiap titik = 1 hotspot"
                                   Foreground="{StaticResource MutedText}" FontSize="11"
                                   Margin="10,8,0,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="LblMapStatus" Text="Memuat data..."
                                   Foreground="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Daftar hotspot -->
                <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.12" />
                    </Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                            <TextBlock Text="Daftar Hotspot" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="LblCount" Text="" Foreground="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <DataGrid x:Name="GridHotspot" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowHeaderWidth="0"
                                  SelectionMode="Single" Margin="4,0,4,4"
                                  MouseDoubleClick="GridHotspot_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Koordinat" Binding="{Binding Koordinat}" Width="*" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="Auto" />
                                <DataGridTextColumn Header="Tingkat" Binding="{Binding Tingkat}" Width="Auto" />
                                <DataGridTextColumn Header="FRP" Binding="{Binding FrpText}" Width="Auto" />
                                <DataGridTextColumn Header="Brightness" Binding="{Binding BrightnessText}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
