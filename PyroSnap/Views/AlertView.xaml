<Page x:Class="PyroSnap.Views.AlertView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1080"
      Title="Peringatan Operasional"
      Background="{StaticResource PageBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeader}">
            <StackPanel>
                <TextBlock Text="Peringatan Operasional" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Dipicu oleh titik panas berkeyakinan tinggi (≥ 80%, kelas LAPAN: segera penanggulangan)"
                           Foreground="White" Opacity="0.9" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="20" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.12" />
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="LblInfo" DockPanel.Dock="Top" Margin="4,0,4,8"
                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Text="Memuat peringatan..." />

                <!-- Bilah pesan (FE-05) -->
                <Border x:Name="BarPesan" DockPanel.Dock="Bottom" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LblPesan" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnBukaHotspot" Content="Buka Titik Panas" Style="{StaticResource PrimaryButton}"
                            Height="36" Margin="0,0,8,0" Click="BtnBukaHotspot_Click" />
                    <Button x:Name="BtnTandai" Content="Tandai Dibaca" Style="{StaticResource SecondaryButton}"
                            Height="36" Margin="0,0,8,0" Click="BtnTandai_Click" />
                    <Button x:Name="BtnTandaiSemua" Content="Tandai Semua Dibaca" Style="{StaticResource SecondaryButton}"
                            Height="36" Margin="0,0,8,0" Click="BtnTandaiSemua_Click" />
                    <Button Content="Kembali" Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Height="36" Click="BtnBack_Click" />
                </StackPanel>

                <DataGrid x:Name="GridAlert" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="13"
                          BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single"
                          AutomationProperties.Name="Daftar peringatan"
                          MouseDoubleClick="GridAlert_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Peringatan belum dibaca ditebalkan -->
                                <DataTrigger Binding="{Binding Baru}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Waktu (lokal)" Binding="{Binding Waktu}" Width="Auto" />
                        <DataGridTextColumn Header="Pesan" Binding="{Binding Pesan}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
