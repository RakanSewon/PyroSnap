<Page x:Class="PyroSnap.Views.AlertView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="1000"
      Title="Peringatan Operasional"
      Background="{DynamicResource PageBg}"
      FontSize="13" Foreground="{DynamicResource TextPrimary}">

    <!-- Judul halaman ada di bilah atas shell (MainWindow). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Belum dibaca" Style="{StaticResource Keterangan}" />
                    <TextBlock x:Name="LblJumlahBaru" Text="-" Style="{StaticResource AngkaKpi}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Kartu}">
                <StackPanel>
                    <TextBlock Text="Peringatan terbaru" Style="{StaticResource Keterangan}" />
                    <TextBlock x:Name="LblJumlahTotal" Text="-" Style="{StaticResource AngkaKpi}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Kartu}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SecondaryBg}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource TeksIkon}" Text="&#xE7ED;" FontSize="18" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource Keterangan}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Peringatan dibuat otomatis saat sinkronisasi menemukan titik berkeyakinan tinggi (≥ 80%) dan dikirim ke semua Admin dan Operator." />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Daftar -->
        <Border Grid.Row="1" Style="{StaticResource Kartu}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnTandai" Content="Tandai dibaca" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="BtnTandai_Click" />
                        <Button x:Name="BtnTandaiSemua" Style="{StaticResource SecondaryButton}" Click="BtnTandaiSemua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TeksIkon}" FontSize="14" Text="&#xE73E;" Margin="0,0,8,0" />
                                <TextBlock Text="Tandai semua dibaca" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Daftar peringatan" Style="{StaticResource JudulKartu}" />
                        <TextBlock x:Name="LblInfo" Style="{StaticResource Keterangan}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" Text="Memuat peringatan..." />
                    </StackPanel>
                </DockPanel>

                <!-- Bilah pesan (FE-05) -->
                <Border x:Name="BarPesan" DockPanel.Dock="Bottom" Style="{StaticResource BilahPesan}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource IkonPesan}" />
                        <TextBlock x:Name="LblPesan" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnBukaHotspot" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnBukaHotspot_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TeksIkon}" FontSize="14" Text="&#xE81D;" Margin="0,0,8,0" />
                            <TextBlock Text="Buka titik panas" />
                        </StackPanel>
                    </Button>
                    <Button Content="Kembali ke Dashboard" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="BtnBack_Click" />
                </StackPanel>

                <DataGrid x:Name="GridAlert" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single"
                          AutomationProperties.Name="Daftar peringatan"
                          MouseDoubleClick="GridAlert_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <!-- Peringatan belum dibaca ditebalkan -->
                                <DataTrigger Binding="{Binding Baru}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="chip" Style="{StaticResource Chip}" Background="{DynamicResource SecondaryBg}">
                                        <TextBlock x:Name="teks" Text="{Binding Status}" FontSize="12"
                                                   Foreground="{DynamicResource MutedText}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Baru}" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource DeltaTurunBg}" />
                                            <Setter TargetName="teks" Property="Foreground" Value="{DynamicResource DeltaTurunFg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Waktu (lokal)" Binding="{Binding Waktu}" Width="Auto" />
                        <DataGridTextColumn Header="Pesan" Binding="{Binding Pesan}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
