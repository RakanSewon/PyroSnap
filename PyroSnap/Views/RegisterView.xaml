<Page x:Class="PyroSnap.Views.RegisterView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1080"
      Title="Daftar Akun Warga"
      Background="{DynamicResource PageBg}"
      FontSize="13" Foreground="{DynamicResource TextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32"
                Style="{StaticResource KartuBesar}" Padding="36">

            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brand}" HorizontalAlignment="Center">
                    <Viewbox Width="28" Height="28">
                        <Path Data="{StaticResource LogoNyala}" Fill="{DynamicResource BrandFg}" />
                    </Viewbox>
                </Border>
                <TextBlock Text="Daftar Akun Warga" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Keterangan}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,28"
                           Text="Dengan akun, wilayah pilihan Anda tersimpan dan Anda bisa mengekspor laporan. Kami hanya menyimpan username dan password (terenkripsi)." />

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="TxtUsername" MaxLength="30"
                         AutomationProperties.Name="Username" />
                <TextBlock Text="3–30 karakter: huruf, angka, titik, atau garis bawah."
                           Style="{StaticResource Keterangan}" Margin="0,4,0,0" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,6" />
                <PasswordBox x:Name="TxtPassword"
                             AutomationProperties.Name="Password" />
                <TextBlock Text="Minimal 8 karakter."
                           Style="{StaticResource Keterangan}" Margin="0,4,0,0" />

                <TextBlock Text="Ulangi password" FontWeight="SemiBold" Margin="0,16,0,6" />
                <PasswordBox x:Name="TxtKonfirmasi"
                             AutomationProperties.Name="Ulangi password" />

                <!-- Bilah pesan (FE-05) -->
                <Border x:Name="BarPesan" Style="{StaticResource BilahPesan}" Margin="0,16,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource IkonPesan}" />
                        <TextBlock x:Name="LblPesan" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>

                <Button x:Name="BtnDaftar" Content="Daftar dan Masuk" Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" Height="44" IsDefault="True" Click="BtnDaftar_Click" />
                <Button Content="Kembali ke Halaman Masuk" Style="{StaticResource SecondaryButton}"
                        Margin="0,8,0,0" Height="40" IsCancel="True" Click="BtnKembali_Click" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
