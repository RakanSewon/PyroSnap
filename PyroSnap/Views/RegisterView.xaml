<Page x:Class="PyroSnap.Views.RegisterView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1080"
      Title="Daftar Akun Warga"
      Background="{StaticResource PageBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                Background="{StaticResource PanelBg}" CornerRadius="12" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Daftar Akun Warga" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource FireRed}" HorizontalAlignment="Center" />
                <TextBlock Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,4,0,20"
                           Text="Dengan akun, wilayah pilihan Anda tersimpan dan Anda bisa mengekspor laporan. Kami hanya menyimpan username dan password (terenkripsi)." />

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtUsername" Padding="8" FontSize="14" MaxLength="30"
                         BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                         AutomationProperties.Name="Username" />
                <TextBlock Text="3–30 karakter: huruf, angka, titik, atau garis bawah."
                           Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,14,0,4" />
                <PasswordBox x:Name="TxtPassword" Padding="8" FontSize="14"
                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                             AutomationProperties.Name="Password" />
                <TextBlock Text="Minimal 8 karakter."
                           Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />

                <TextBlock Text="Ulangi password" FontWeight="SemiBold" Margin="0,14,0,4" />
                <PasswordBox x:Name="TxtKonfirmasi" Padding="8" FontSize="14"
                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                             AutomationProperties.Name="Ulangi password" />

                <!-- Bilah pesan (FE-05) -->
                <Border x:Name="BarPesan" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="LblPesan" TextWrapping="Wrap" FontSize="13"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <Button x:Name="BtnDaftar" Content="Daftar dan Masuk" Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0" Height="42" IsDefault="True" Click="BtnDaftar_Click" />
                <Button Content="Kembali ke Halaman Masuk" Style="{StaticResource SecondaryButton}"
                        Margin="0,8,0,0" Height="36" IsCancel="True" Click="BtnKembali_Click" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
