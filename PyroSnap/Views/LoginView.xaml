<Page x:Class="PyroSnap.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1280"
      Title="Masuk"
      Background="{DynamicResource PageBg}"
      FontSize="13" Foreground="{DynamicResource TextPrimary}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32"
                    Style="{StaticResource KartuBesar}" Padding="36">
                <StackPanel>
                    <!-- Logo -->
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brand}" HorizontalAlignment="Center">
                        <Viewbox Width="28" Height="28">
                            <Path Data="{StaticResource LogoNyala}" Fill="{DynamicResource BrandFg}" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Masuk ke PyroSnap" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Pemantauan titik panas (hotspot) Indonesia" Style="{StaticResource Keterangan}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,28" />

                    <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtUsername" AutomationProperties.Name="Username" />

                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <PasswordBox x:Name="TxtPassword" AutomationProperties.Name="Password" />

                    <Border x:Name="BarPesan" Style="{StaticResource BilahPesan}" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource IkonPesan}" />
                            <TextBlock x:Name="LblPesan" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </DockPanel>
                    </Border>

                    <!-- UX-09: Enter mengirim form -->
                    <Button x:Name="BtnLogin" Content="Masuk" Style="{StaticResource PrimaryButton}"
                            Margin="0,24,0,0" Height="44" IsDefault="True" Click="BtnLogin_Click" />

                    <!-- Jalur warga (K10) -->
                    <Grid Margin="0,24,0,16">
                        <Separator Margin="0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource PanelBg}" Padding="10,0" HorizontalAlignment="Center">
                            <TextBlock Text="Warga" Style="{StaticResource Keterangan}" />
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDaftar" Content="Daftar akun" Style="{StaticResource SecondaryButton}"
                                Height="40" Click="BtnDaftar_Click" />
                        <Button x:Name="BtnTamu" Grid.Column="2" Content="Masuk sebagai Tamu" Style="{StaticResource SecondaryButton}"
                                Height="40" Click="BtnTamu_Click"
                                ToolTip="Lihat peta dan informasi tanpa akun. Tamu tidak bisa mengekspor laporan." />
                    </Grid>
                    <Button Style="{StaticResource NavAksi}" Tag="&#xE897;" Content="Panduan &amp; Kontak Darurat"
                            HorizontalAlignment="Center" Margin="0,12,0,0" Click="BtnPanduan_Click" />

                    <!-- Status koneksi database (dicek di latar belakang, tidak memblokir login) -->
                    <TextBlock x:Name="LblDbStatus" Text="Database: memeriksa koneksi..."
                               Style="{StaticResource Keterangan}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- DS-06: tema bisa diganti sebelum masuk -->
        <Button x:Name="BtnTema" Style="{StaticResource TombolIkon}" Content="&#xE708;"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
                AutomationProperties.Name="Ganti tema" ToolTip="Ganti tema terang/gelap" Click="BtnTema_Click" />
    </Grid>
</Page>
