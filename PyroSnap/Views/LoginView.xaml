<Page x:Class="PyroSnap.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1080"
      Title="Masuk"
      Background="{StaticResource PageBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                Background="{StaticResource PanelBg}" CornerRadius="12" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🔥 PyroSnap" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource FireRed}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Pemantauan Titik Panas (Hotspot) Indonesia"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,2,0,24" />

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtUsername" Padding="8" FontSize="14"
                         BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                         AutomationProperties.Name="Username" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,4" />
                <PasswordBox x:Name="TxtPassword" Padding="8" FontSize="14"
                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                             AutomationProperties.Name="Password" />

                <TextBlock x:Name="LblError" Foreground="{StaticResource FireRed}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" />

                <!-- UX-09: Enter mengirim form -->
                <Button x:Name="BtnLogin" Content="Masuk" Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0" Height="42" IsDefault="True" Click="BtnLogin_Click" />

                <!-- Jalur warga (K10) -->
                <TextBlock Text="Warga?" Foreground="{StaticResource MutedText}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <Button x:Name="BtnDaftar" Content="Daftar Akun Warga" Style="{StaticResource SecondaryButton}"
                        Height="38" Click="BtnDaftar_Click" />
                <Button x:Name="BtnTamu" Content="Masuk sebagai Tamu" Style="{StaticResource SecondaryButton}"
                        Height="38" Margin="0,8,0,0" Click="BtnTamu_Click"
                        ToolTip="Lihat peta dan informasi tanpa akun. Tamu tidak bisa mengekspor laporan." />
                <Button Content="Panduan &amp; Kontak Darurat" Style="{StaticResource SecondaryButton}"
                        Height="34" Margin="0,8,0,0" FontSize="13" Click="BtnPanduan_Click" />

                <!-- Status koneksi database (dicek di latar belakang, tidak memblokir login) -->
                <TextBlock x:Name="LblDbStatus" Text="Database: memeriksa koneksi..."
                           Foreground="{StaticResource MutedText}" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
