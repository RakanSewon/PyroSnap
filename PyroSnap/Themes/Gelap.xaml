<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tema Gelap PyroSnap (DS-06/DS-07; docs/ui/design-system.md).
        Hanya warna. Kunci HARUS sama dengan Themes/Terang.xaml.
        Gaya & template ada di Themes/Gaya.xaml dan selalu memakai DynamicResource.
        Rasio kontras di komentar dihitung dengan rumus WCAG (terang / gelap).
    -->
    <SolidColorBrush x:Key="PageBg" Color="#FF111311" /> <!-- Latar jendela/halaman -->
    <SolidColorBrush x:Key="PanelBg" Color="#FF1B1E1B" /> <!-- Kartu & panel -->
    <SolidColorBrush x:Key="CardBorder" Color="#FF2A2E29" /> <!-- Garis tepi kartu (dekoratif) -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFECEEEA" /> <!-- Teks utama (14,96 / 15,99 di latar) -->
    <SolidColorBrush x:Key="MutedText" Color="#FFA3A8A1" /> <!-- Teks sekunder (5,28 / 7,71 di latar) -->
    <SolidColorBrush x:Key="InkBg" Color="#FFECEEEA" /> <!-- Elemen aktif/utama: tombol utama, tab & nav aktif, baris terpilih -->
    <SolidColorBrush x:Key="InkFg" Color="#FF111311" /> <!-- Teks di atas InkBg (16,92 / 15,99) -->
    <SolidColorBrush x:Key="SecondaryBg" Color="#FF262A26" /> <!-- Tombol sekunder, chip, tombol ikon -->
    <SolidColorBrush x:Key="SecondaryHoverBg" Color="#FF30352F" /> <!-- Hover tombol sekunder -->
    <SolidColorBrush x:Key="SecondaryFg" Color="#FFECEEEA" /> <!-- Teks tombol sekunder (15,08 / 12,48) -->
    <SolidColorBrush x:Key="NavHoverBg" Color="#FF232723" /> <!-- Hover menu samping -->
    <SolidColorBrush x:Key="InputBg" Color="#FF222622" /> <!-- Latar isian -->
    <SolidColorBrush x:Key="InputBorder" Color="#FF7C807A" /> <!-- Batas isian (3,46 / 4,19 di panel) -->
    <SolidColorBrush x:Key="FocusRing" Color="#FF8AB4F8" /> <!-- Cincin fokus keyboard (8,66 / 7,98) -->
    <SolidColorBrush x:Key="GridLine" Color="#FF2A2E29" /> <!-- Garis tabel (dekoratif) -->
    <SolidColorBrush x:Key="SelectionBg" Color="#FFECEEEA" /> <!-- Baris terpilih (= InkBg) -->
    <SolidColorBrush x:Key="SelectionFg" Color="#FF111311" /> <!-- Teks baris terpilih -->
    <SolidColorBrush x:Key="DeltaNaikBg" Color="#FF16351F" /> <!-- Pil indikator positif -->
    <SolidColorBrush x:Key="DeltaNaikFg" Color="#FF8FE3A5" /> <!-- (5,72 / 8,76) -->
    <SolidColorBrush x:Key="DeltaTurunBg" Color="#FF3F1D1B" /> <!-- Pil indikator bahaya -->
    <SolidColorBrush x:Key="DeltaTurunFg" Color="#FFFFB4AB" /> <!-- (6,06 / 8,82) -->
    <SolidColorBrush x:Key="Brand" Color="#FFDC4437" /> <!-- Lingkaran logo (6,57 / 3,95 di panel) -->
    <SolidColorBrush x:Key="BrandFg" Color="#FFFFFFFF" /> <!-- Nyala di logo (6,57 / 4,26) -->
    <SolidColorBrush x:Key="FireRed" Color="#FFFF8A80" /> <!-- Teks bahaya/error (6,57 / 7,37 di panel) -->
    <SolidColorBrush x:Key="MapBg" Color="#FF1E2227" /> <!-- Latar area peta -->
    <SolidColorBrush x:Key="OverlayBg" Color="#CC1B1E1B" /> <!-- Lapisan semi-transparan -->
    <SolidColorBrush x:Key="TingkatTinggi" Color="#FFFF6B5E" /> <!-- Tingkat Tinggi (6,65 / 5,72 di peta) -->
    <SolidColorBrush x:Key="TingkatNominal" Color="#FFFFA040" /> <!-- Tingkat Nominal (4,10 / 7,88) -->
    <SolidColorBrush x:Key="TingkatRendah" Color="#FFE6C84A" /> <!-- Tingkat Rendah (4,01 / 9,69) -->
    <SolidColorBrush x:Key="TingkatTinggiTepi" Color="#FFFFFFFF" /> <!-- Tepi tebal khusus Tinggi -->
    <SolidColorBrush x:Key="TingkatTepi" Color="#FF1B1E1B" /> <!-- Tepi tipis Nominal & Rendah -->
    <SolidColorBrush x:Key="PesanInfoBg" Color="#FF1E2D3B" /> <!-- Bilah info -->
    <SolidColorBrush x:Key="PesanInfoFg" Color="#FFBBD7F0" /> <!-- (8,27 / 9,43) -->
    <SolidColorBrush x:Key="PesanPeringatanBg" Color="#FF3A2A12" /> <!-- Bilah peringatan -->
    <SolidColorBrush x:Key="PesanPeringatanFg" Color="#FFFFD7A3" /> <!-- (7,61 / 10,20) -->
    <SolidColorBrush x:Key="PesanErrorBg" Color="#FF3F1D1B" /> <!-- Bilah error -->
    <SolidColorBrush x:Key="PesanErrorFg" Color="#FFFFB4AB" /> <!-- (5,74 / 8,82) -->
</ResourceDictionary>
